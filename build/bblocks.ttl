<https://ogcincubator.github.io/activity-type-register/> a skos:ConceptScheme,
        dcat:Catalog,
        bblocks:BBlocksRegister ;
    rdfs:label "Building Blocks - Activity Type Register" ;
    dct:abstract """A register of generic activity types, implemented as a profile of the Registered Item Model: the activity type,
geoprocessing and machine learning profiles, and the generic activity types grouped into families.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:description """The profiles in this register are implemented as classes of the Registered Item Model, which lives in a separate [register](https://ogcincubator.github.io/registered-item-model/). 
The intent for this register is to be the generic 'top level' register that federated registers can inherit from for specific activity profiles in the respective domains.
The generic activity types live under `https://w3id.org/ogc/ospd/activity-type/`; federated registers, such as the
[OSPD activity types register](https://ogcincubator.github.io/ospd-activity-types/), specialise them with `skos:broader`.
"""^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
    dct:modified "2026-11-25T11:09:17.803836"^^xsd:dateTime ;
    void:sparqlEndpoint <https://defs-hosted.opengis.net/fuseki-ospd/query> ;
    owl:imports <https://ogcincubator.github.io/registered-item-model/build/register.json>,
        <https://opengeospatial.github.io/bblocks/register.json> ;
    skos:hasTopConcept <bblocks://ogc.register.profiles.activity-types>,
        <bblocks://ogc.register.profiles.geoprocessing-activity-types>,
        <bblocks://ogc.register.profiles.schemas.activity-types-schema>,
        <bblocks://ogc.register.profiles.schemas.geoprocessing-activity-types-schema>,
        <bblocks://ogc.register.profiles.schemas.st-ml-activity-types-schema>,
        <bblocks://ogc.register.profiles.st-ml-activity-types>,
        <bblocks://ogc.register.types.core>,
        <bblocks://ogc.register.types.earth-observation>,
        <bblocks://ogc.register.types.information-extraction-and-retrieval>,
        <bblocks://ogc.register.types.ml-and-statistical-modeling>,
        <bblocks://ogc.register.types.point-cloud-processing>,
        <bblocks://ogc.register.types.raster-coverage-processing>,
        <bblocks://ogc.register.types.spatial-indexing>,
        <bblocks://ogc.register.types.terrain-and-hydrology>,
        <bblocks://ogc.register.types.vector-geometry-processing>,
        <bblocks://ogc.register.types.workflow-and-scoring> ;
    skos:prefLabel "Building Blocks - Activity Type Register" ;
    prof:hasResource [ rdfs:label "This Building Blocks Register in JSON format" ;
            dct:type "application/json" ;
            ns2:relation <http://www.iana.org/assignments/relation/self> ;
            ns1:hasTarget <https://ogcincubator.github.io/activity-type-register/build/register.json> ],
        [ rdfs:label "This Building Blocks Register in RDF Turtle format" ;
            dct:type "text/turtle" ;
            ns2:relation <http://www.iana.org/assignments/relation/self> ;
            ns1:hasTarget <https://ogcincubator.github.io/activity-type-register/build/bblocks.ttl> ],
        [ rdfs:label "This Building Blocks Register in JSON-LD format" ;
            dct:type "application/ld+json" ;
            ns2:relation <http://www.iana.org/assignments/relation/self> ;
            ns1:hasTarget <https://ogcincubator.github.io/activity-type-register/build/bblocks.jsonld> ] ;
    foaf:homepage <https://ogcincubator.github.io/activity-type-register/> ;
    bblocks:hasValidationReport <https://ogcincubator.github.io/activity-type-register/build/tests/report.html> .

