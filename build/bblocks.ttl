            rdfs:isDefinedBy <https://ogcincubator.github.io/activity-type-register/build/generateddocs/json-full/register/profiles/schemas/st-ml-activity-types-schema/index.json> ],
        "See the ogc.register.profiles.st-ml-activity-types model for the description of the SpatioTemporal ML Activity Types Profile. This building block is a Schema representation of that block for json schema implementation purposes."^^<https://www.w3.org/ns/iana/media-types/text/markdown> ;
