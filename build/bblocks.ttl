            rdfs:isDefinedBy <https://ogcincubator.github.io/activity-type-register/build/generateddocs/markdown/register/profiles/schemas/st-ml-activity-types-schema/index.md> ],
        [ dct:format "text/html" ;
            rdfs:isDefinedBy <https://ogcincubator.github.io/activity-type-register/bblock/ogc.register.profiles.schemas.st-ml-activity-types-schema> ],
