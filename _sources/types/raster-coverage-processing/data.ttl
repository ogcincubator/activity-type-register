<https://w3id.org/ogc/ospd/activity-type/families/raster-coverage-processing> a skos:ConceptScheme ;
    skos:definition "Operations on rasters and coverages: reprojection, resampling, cropping, mosaicking, format conversion, rendering, band math, spectral indices and zonal analysis."@en ;
    skos:hasTopConcept ospd:GA008,
        ospd:GA010,
        ospd:GA011,
        ospd:GA018,
        ospd:GA032,
        ospd:otsu-thresholding,
        ospd:radiometric-index,
        ospd:raster-band-math,
        ospd:raster-band-math-multiband,
        ospd:raster-crop,
        ospd:raster-extent,
        ospd:raster-format-conversion,
        ospd:raster-rendering,
        ospd:raster-reprojection,
        ospd:raster-resampling ;
    skos:prefLabel "Raster coverage processing"@en .

